# Настройки приложения
APP_NAME=Reading List API
APP_VERSION=1.0.0
DEBUG=false

# Настройки базы данных
# Для разработки (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./reading_list.db

# Для продакшена (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://reading_list_user:reading_list_pass@localhost:5432/reading_list
DATABASE_ECHO=false

# Настройки API
API_PREFIX=/api/v1

# Настройки пагинации
DEFAULT_LIMIT=20
MAX_LIMIT=100
