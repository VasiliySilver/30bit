# Переменные окружения для Docker Compose

# PostgreSQL настройки
POSTGRES_DB=reading_list
POSTGRES_USER=reading_list_user
POSTGRES_PASSWORD=reading_list_pass
POSTGRES_PORT=5432

# API настройки
API_PORT=8000
DEBUG=true
API_PREFIX=/api/v1

# Database URL (используется приложением)
DATABASE_URL=postgresql+asyncpg://reading_list_user:reading_list_pass@postgres:5432/reading_list
